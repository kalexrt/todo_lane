# LANE project config
# test_cmd: fill in before red/green/review. red/green append changed TEST FILE PATHS to it
# (`pytest tests/T-001/x.py`), so it must accept file arguments — pytest | npx vitest run |
# bun test do; `go test ./...` and `make test` do NOT (start probes this and refuses/warns).
# This is the DEFAULT runner — it owns the whole repo (root "."). A single-harness project
# needs only this. For a MULTI-HARNESS monorepo (e.g. a Python backend + a JS frontend with
# DIFFERENT runners), add a runner.* matrix below; the default still catches anything no
# named runner owns. Leave test_cmd empty when every test path is covered by a named runner.
test_cmd: ""
runner.api.root:            backend
runner.api.test_cmd:        npx jest
runner.api.test_ran_pattern: "Tests:.*[0-9]+ (passed|failed)"
runner.api.setup_cmd:       npm ci
runner.web.root:            frontend
runner.web.test_cmd:        npx vitest run
runner.web.test_ran_pattern: "Tests +[0-9]+ (passed|failed)"
runner.web.setup_cmd:       npm ci
# ── runner.* matrix (OPTIONAL — multi-harness monorepos) ─────────────────────────────────
# Each named runner OWNS a subtree (`root`) and RUNS IN IT (cwd = root, so vitest finds its
# config + node_modules, pytest its conftest). Every changed test file routes to the runner
# whose root is its longest directory-prefix; red/green/verify run each bucket in its own
# root and aggregate (a GREEN means EVERY harness is green). Each runner carries its OWN
# test_ran_pattern (no single regex can match pytest's `collected N` AND vitest's `Tests N`)
# and an OPTIONAL per-runner setup_cmd (run in its root; the top-level setup_cmd below is the
# SHARED step, run at the repo root). `lane start` probes each runner independently. Roots
# must be distinct (ambiguous routing is refused). Delete this block for a single-harness repo:
#   runner.api.root:            backend
#   runner.api.test_cmd:        pytest
#   runner.api.test_ran_pattern: collected [1-9]
#   runner.api.setup_cmd:       "python -m venv .venv && .venv/bin/pip install -r requirements.txt"
#   runner.web.root:            frontend
#   runner.web.test_cmd:        npx vitest run
#   runner.web.test_ran_pattern: "Tests +[0-9]+ (passed|failed)"
#   runner.web.setup_cmd:       npm ci
# integration_branch: the team's merge target — a task is COMPLETE once its branch merges here
# (ADR-0006). ENFORCED by `lane start`: a fresh claim must fork FROM this branch — the base
# is what carries the approved specs and the committed toolchain that `lane verify` replays
# against. Set it to your real merge target (main/master/dev). Empty = unenforced (solo or
# not yet agreed). See fork_policy below for the stacked-flow opt-out.
integration_branch: "main"
# fork_policy: how strictly `lane start` holds the fork base. Empty (default) = strict:
# refuse a fresh claim from any branch other than integration_branch. "stacked" = allow
# forking from another branch (stacked tasks / staging flows) — an explicit, committed,
# reviewable opt-out; start still warns on every stacked fork.
fork_policy: ""
# worktree_base: where task worktrees live. Empty (default) = a per-repo sibling dir
# `<repo>.wt/` next to your checkout — collision-proof when several projects share a
# parent dir. Relative paths resolve against the main checkout.
worktree_base: ""
# setup_cmd: provisions deps in a fresh worktree (run by `start`) so RED/GREEN
# can run on arrival. Empty = skip (verify/done warn the replay worktree has no deps).
# Set `none` to skip SILENTLY when the project intentionally needs no setup. Set per stack:
#   node → "npm ci"   python → "python -m venv .venv && .venv/bin/pip install -r requirements.txt"
#   go   → "go mod download"
setup_cmd: ""
# replay_env: prepares hermetic-test prerequisites in the FRESH replay worktree (run by
# `lane verify` after setup_cmd): seed a test DB, copy checked-in fixtures, start a local
# service (e.g. "docker compose up -d db"). Empty = skip. The hermetic rule: ledger tests
# must pass from a fresh clone given setup_cmd + replay_env alone — a test that needs
# anything else passes at `lane green` (your shell) but FAILS verify's replay.
replay_env: ""
# test_ran_pattern: regex proving tests EXECUTED (matched against test_cmd output).
# It hardens the GREEN side (and verify/review): with it set, an exit-0 run that
# executed ZERO tests is refused as a false GREEN (a filtered / empty / --passWithNoTests
# run proves nothing). RED is intentionally NOT gated on execution — a test that fails an
# assertion AND a test that won't even load because the code is absent (the normal
# import/compile-error first RED, philosophy §2) are both valid REDs, so you do NOT need to
# make this pattern match collection errors. Without it, green/verify trust exit codes alone
# (and warn). The runner-accepts-file-args contract is proven once at `lane start`.
# Set the pattern to match your runner's pass/total line:
#   node --test → "# tests [1-9]"   pytest → "collected [1-9]"
#   go test     → "^(ok|FAIL|---)"  jest   → "Tests:.*[0-9]+ (passed|failed)"
#   vitest      → "Tests +[0-9]+ (passed|failed)"
test_ran_pattern: ""
# NOTE (ADR-0002): RED/GREEN gate on the ledger replay, not output parsing. They COMMIT a
# ledger (Lane-Phase trailers) and `lane verify` (run at done) replays it — proving the
# same test text went fail→pass across the RED→GREEN boundary. So you only NEED test_cmd;
# `test_ran_pattern` above hardens the GREEN side of red/green/verify/review against runs
# where no test executed. `verify` also audits ledger COVERAGE: a plain (no-trailer) commit may only
# contain docs/meta changes or new test-only guards — source changes must arrive via
# red/green/refactor. `test_collect_error_pattern` is DEPRECATED (the replay subsumes it).
test_collect_error_pattern: ""  # deprecated — ignored by red/green under the replay model
# commit_hook_policy: how lane's checkpoint commits treat THIS repo's pre-commit hook (issue
# #84). A first-step RED commits a test that, by design, does not compile yet (it imports the
# code GREEN will build, philosophy §2) — a tsc/lint/test pre-commit hook can only REJECT that
# valid RED, never improve it. So:
#   red-bypass (default) — bypass the hook for RED test commits; HONOR it for green/refactor.
#                          All PRODUCTION source still passes the hook (it lands at GREEN), and
#                          lane's own secret-file refusal runs regardless. The principled default.
#   respect              — honor the hook for ALL commits (pre-#84 behavior). A non-compiling
#                          first-step RED will be BLOCKED — you must stub to get past it.
#   bypass               — skip the hook for EVERY ledger commit. Source no longer passes the
#                          host hook on the way in — a committed, visibly-weaker opt-out.
# lane start prints the active policy when it detects a pre-commit hook. Empty = red-bypass.
commit_hook_policy: ""
# approve_mode: how `lane approve` obtains consent. Default (empty) = interactive:
# a human must run it at a real terminal and answer y/N; lane then writes the
# approval stamp (approved_by/at + approved_sha256 content hash) itself — hand-typed
# stamps never validate, and editing an approved artifact reopens its gate.
# "unattended" = stamp without confirmation (CI/scripts). This is a committed,
# reviewable opt-out into weaker gates — every approve prints a warning under it.
approve_mode: "unattended"
# autonomy_mode: how the agent behaves at an ambiguous decision under the Claude Stop-hook
# autonomy loop (`lane guard`). Default (empty) = "attended": the agent MAY stop to ask a
# human, and `lane guard` lets that stop through. "unattended" = no human present: the agent
# must NOT stop to ask — it takes the RECOMMENDED default and notes why. Pairs with
# approve_mode for fully-headless CI runs. NB: these hooks are an autonomy DRIVER (they can
# fail a *stop*), not enforcement of the git/approval gates — those are unchanged.
autonomy_mode: "unattended"
# autonomy_max_repeats: `lane guard` allows a stop once the SAME next-step repeats this many
# turns with no progress — a graceful pre-empt of Claude's hard 8-block cap. Default 4.
autonomy_max_repeats: "4"
# auto_land: what `lane guard` does at a DONE task (work + verification complete, merge
# pending). Default (empty/false) = let the agent stop; integration happens outside lane via
# a PR merge or a human running `lane land`. "true" = the agent runs `lane land <id>` itself
# to complete the local guarded merge — for repos that integrate per-task locally (team or
# solo). Does not change how `lane land` works; only whether the autonomy loop drives it.
auto_land: ""
# critic_cmd: OPTIONAL fallback for running the reviewer (Critic) when no agent/human
# drives it (CI, scripts). Empty = none; produce the report via a Critic subagent or by
# hand. It receives LANE_SPEC, LANE_DIFF_FILE, LANE_REPORT_OUT; writes the report; exit 0=clean.
# `done` won't merge until that report exists, has no placeholders, and every flag is resolved.
# Human re-review is the PR's job (teams: enable branch protection so a non-author approves).
critic_cmd: ""
# route_cmd: OPTIONAL agent for the JUDGMENT routing signals (ambiguity, blast radius,
# security) used by `lane route`. Empty = none; route prints a human checklist
# instead. It receives LANE_CARD, LANE_TSD, LANE_PLAN; prints its assessment and,
# optionally, a line `LANE_JUDGMENT_FIRED: <0-3>` that route folds into the tally.
# Routing is advisory (§7) — a recommendation, never a gate.
route_cmd: ""
# Draft assists (philosophy §8): operator / domain-expert prompts the session applies
# WHILE drafting an authoring artifact, so the expansion is TUNED to this project (e.g.
# "every money-movement story must specify an idempotency key"). Value = an inline prompt
# string OR a file path (starting with . or /, resolved against the repo) whose contents
# are the prompt. The session reads the artifact and runs the prompt — multi-turn, and it
# MAY invoke skills or subagents — then proceeds to the human approval gate.
# Advisory, NOT a gate: AI is optional and lane cannot prove an assist ran, so the
# approved_by frontmatter stamp stays the only mechanical check. Empty (or `none`) = no
# assist, silent. A configured path that does not exist is SKIPPED with a warning, never a
# block. Starter assists are scaffolded into .lane/assists/ by lane init — edit to taste;
# see .lane/assists/EXAMPLES.md for ideas (that file is reference only, never loaded).
# TOGGLE: each assist has an `_enabled` flag (default true). Set it to false to PAUSE the
# assist without deleting the instruction — real-time on/off control per step. One pair
# per authoring step:
assist_briefing:          ""  # e.g. .lane/assists/briefing.md  or  "Run /grill-me on the briefing."
assist_briefing_enabled:  true
assist_prd:               ""  # e.g. .lane/assists/prd.md
assist_prd_enabled:       true
assist_tsd:               ""  # e.g. .lane/assists/tsd.md
assist_tsd_enabled:       true
assist_breakdown:         ""  # e.g. .lane/assists/breakdown.md — tune how TSD stories slice into task cards
assist_breakdown_enabled: true
assist_plan:              ""  # e.g. .lane/assists/plan.md  or  "Act as SA; challenge the plan before I approve."
assist_plan_enabled:      true
# assist_context tunes `lane hydrate` — the methodology for filling docs/context/* from the
# codebase. UNLIKE the assists above it ships ACTIVE (defaulted at the scaffolded file), so a
# fresh repo can hydrate out of the box; override the file, point elsewhere, or disable it.
assist_context:           ".lane/assists/context.md"
assist_context_enabled:   true
# Context grounding (ADR-0019, ADR-0020): when ON (default), LANE treats docs/context/* —
# CONSTITUTION (conventions/stack), BLUEPRINT (architecture/boundaries), PRODUCT (scope) —
# as binding constraints when drafting specs, and `lane fold status` reports each doc's
# readiness (absent / stub / filled). It is a GATE at the TSD: `lane approve` refuses a TSD
# while any context doc is a stub/absent — a TSD invents architecture and must ground in real
# constraints (run `lane hydrate` to fill them). PRD/Briefing are NOT gated (a greenfield
# repo's first PRD is what defines the product). Set false to handle grounding your own way —
# LANE then stays out of it entirely (no gate) and reports grounding as operator-managed.
use_lane_context_doc:     true
